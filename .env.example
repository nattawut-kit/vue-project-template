# คัดลอกเป็น .env.development (local) แล้วเติมค่า ห้าม commit ไฟล์ .env จริง
# ค่า VITE_* ถูกฝังลง bundle เป็นข้อมูล public ห้ามใส่ secret (ดู docs/secrets.md)

VITE_APP_VERSION=0.0.0
VITE_BUILD_MODE=development

# base URL ของ backend, ใช้ /api เพื่อผ่าน proxy ของ vite dev server
VITE_API_BASE_URL=/api

# เว้นว่าง = ไม่ใช้ LINE LIFF login
VITE_LIFF_ID=

# ปลายทางของ proxy /api ตอน dev (prefix API_ จึงไม่ถูกฝังลง bundle)
API_PROXY_TARGET=http://localhost:5000
